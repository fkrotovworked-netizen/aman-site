---
// Шапка внутренней страницы.
// С кадром: фото во всю ширину и почти во всю высоту экрана, тёплый свет, заголовок снизу слева,
// под ним золотой горизонт, ниже — вводный абзац и действия. Шапка сайта лежит поверх (overlayHeader).
// Без кадра: тёмный экран со светом солнца — для карты рынков и политики.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
  /** данные под горизонтом справа: координаты, группа и т. п. */
  caption?: string;
  /** подпись «Фото — иллюстрации» */
  /** положение солнца на кадре, % по горизонтали */
  sunX?: string;
}
const { title, lead, image, imageAlt = '', imagePosition = '50% 50%', caption, sunX = '72%' } = Astro.props;
const hasActions = Astro.slots.has('default');
---

<header class:list={['ph', image ? 'ph--frame' : 'ph--plain sunlit']} data-sunset="head" style={`--pos:${imagePosition};--sun-x:${sunX}`}>
  {
    image && (
      <>
        <div class="ph__media">
          <Picture
            src={image}
            formats={['avif', 'webp']}
            widths={[640, 960, 1440, 1920, 2400]}
            sizes="100vw"
            alt={imageAlt}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="ph__shade" aria-hidden="true" />
        <div class="ph__sun" aria-hidden="true" />
      </>
    )
  }
  <div class="wrap ph__inner">
    <h1 class="ph__title">{title}</h1>
    <div class="ph__line" aria-hidden="true">
      <span class="ph__rule"></span>
      {caption && <span class="ph__cap mono">{caption}</span>}
    </div>
    {
      (lead || hasActions) && (
        <div class="ph__foot">
          {lead && <p class="ph__lead">{lead}</p>}
          {hasActions && (
            <div class="ph__actions actions">
              <slot />
            </div>
          )}
        </div>
      )
    }
  </div>
</header>

<style>
  .ph {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: end;
    color: var(--on-dark);
    background: var(--ink-950);
  }
  .ph--frame {
    min-height: max(36rem, 88svh);
    padding-block: calc(var(--header-h) + 4rem) clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }
  /* свет гаснет к низу шапки, чтобы не было шва со следующей секцией */
  .ph--plain::before {
    -webkit-mask-image: linear-gradient(180deg, #000 45%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 45%, transparent 100%);
  }
  .ph--plain {
    padding-block: calc(var(--header-h) + clamp(3.5rem, 2rem + 6vw, 8rem)) clamp(2.5rem, 1.5rem + 3vw, 4rem);
    background: var(--ink-900);
  }

  /* — кадр — */
  .ph__media,
  .ph__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .ph__media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ph__media :global(img) {
    width: 100%;
    max-width: none;
    height: 100% !important;
    object-fit: cover;
    object-position: var(--pos);
    animation: ph-img 1800ms var(--ease-out) both;
  }
  @keyframes ph-img {
    from {
      transform: scale(1.05);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
  }
  .ph__shade {
    background:
      linear-gradient(180deg, rgb(14 13 10 / 0.6) 0%, rgb(14 13 10 / 0) 24%),
      linear-gradient(0deg, rgb(14 13 10 / 0.94) 0%, rgb(14 13 10 / 0.66) 32%, rgb(14 13 10 / 0) 68%),
      linear-gradient(90deg, rgb(14 13 10 / 0.42) 0%, rgb(14 13 10 / 0) 60%),
      linear-gradient(0deg, rgb(40 24 6 / 0.22), rgb(40 24 6 / 0.22));
  }
  /* тёплый свет из-за кадра — тот же, что в hero, только тише */
  .ph__sun {
    position: absolute;
    left: var(--sun-x);
    top: 8%;
    z-index: -1;
    width: min(64rem, 140vw);
    aspect-ratio: 2 / 1;
    pointer-events: none;
    mix-blend-mode: screen;
    background: radial-gradient(closest-side, rgb(255 222 160 / 0.34), rgb(240 170 80 / 0.14) 40%, transparent 76%);
    transform: translate(-50%, -50%);
    animation: ph-sun 2600ms var(--ease-out) 120ms both;
    translate: 0 calc(var(--sun-k, 0) * 30%);
    opacity: calc(1 - var(--sun-k, 0) * 0.7);
  }
  @keyframes ph-sun {
    from {
      opacity: 0;
      transform: translate(-50%, -40%) scale(0.8);
    }
  }

  /* — текст — */
  .ph__inner {
    display: grid;
    width: 100%;
  }
  .ph__title {
    font-size: var(--fs-display);
    font-weight: 360;
    line-height: var(--lh-display);
    letter-spacing: var(--tr-display);
    color: var(--paper-50);
    max-width: 14ch;
    text-wrap: balance;
  }
  .ph__line {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-4);
    margin-top: clamp(1.75rem, 1rem + 2vw, 3rem);
  }
  .ph__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--gold-300), rgb(232 168 82 / 0.55) 40%, rgb(232 168 82 / 0.18));
    box-shadow: 0 0 12px 0 rgb(232 168 82 / 0.35);
    transform-origin: 0 50%;
    animation: ph-rule 1400ms var(--ease-out) 250ms both;
  }
  @keyframes ph-rule {
    from {
      transform: scaleX(0);
    }
  }
  .ph__cap {
    flex: none;
    color: var(--gold-200);
    font-feature-settings: 'tnum';
  }
  .ph__foot {
    display: grid;
    gap: var(--s-6);
    margin-top: clamp(1.25rem, 0.8rem + 1.4vw, 2rem);
    justify-items: start;
  }
  .ph__lead {
    color: var(--paper-200);
    font-size: var(--fs-lead);
    line-height: 1.5;
    max-width: 36rem;
    text-wrap: pretty;
  }
  @media (min-width: 64rem) {
    .ph__foot {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: var(--s-12);
    }
    .ph__actions {
      justify-content: end;
    }
  }
  @media (max-width: 35.99rem) {
    .ph__cap {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ph__media :global(img),
    .ph__sun,
    .ph__rule {
      animation: none;
    }
  }
</style>
