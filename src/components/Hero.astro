---
// Первый экран: пшеничное поле на закате — колосья качаются на ветру (видео-петля поверх постера),
// линия горизонта совпадает с горизонтом кадра
// и становится фирменной линией сайта. Заголовок — снизу слева, рабочая форма — справа.
// Один авторский момент: горизонт прочерчивается от солнца, строки заголовка выходят из-под линии.
import { Picture } from 'astro:assets';
import QuotePanel from './QuotePanel.astro';
import Button from './Button.astro';
import heroImg from '@/assets/hero/hero-field.jpg';
import { t } from '@/i18n/content';
import { href, type Lang } from '@/i18n/routes';
import { company } from '@/data/company';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
// видео лежит в public/ — путь от базы сборки (на GitHub Pages сайт в подпапке)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero" aria-labelledby="hero-title" data-sunset="head">
  <div class="hero__stage">
    <div class="hero__media">
      <Picture
        src={heroImg}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1920, 2560, 3000]}
        sizes="100vw"
        alt={lang === 'ru' ? 'Пшеничное поле на закате, низкое солнце над холмами' : 'Wheat field at sunset, low sun over the hills'}
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
      <!-- Колосья на ветру: бесшовная петля 4,9 с. Запускает скрипт ниже — не при reduced motion и не при экономии трафика -->
      <video class="hero__video" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" data-hero-video>
        <source src={`${base}/video/hero-field-720.mp4`} type="video/mp4" media="(max-width: 37.5rem)" />
        <source src={`${base}/video/hero-field-1920.mp4`} type="video/mp4" />
      </video>
    </div>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__sun" aria-hidden="true"></div>

    <div class="hero__horizon" aria-hidden="true">
      <span class="hero__line"></span>
      <span class="hero__coords mono">{d.home.heroCaption} · {company.coords.label}</span>
    </div>

    <div class="hero__content wrap">
      <div class="hero__copy">
        <h1 id="hero-title" class="hero__title">
          {
            d.home.heroTitle.map((line, i) => (
              <span class="hero__ln" style={`--i:${i}`}>
                <span>{line}</span>
              </span>
            ))
          }
        </h1>
        <p class="hero__text">{d.home.heroText}</p>
        <div class="hero__actions">
          <Button href={href(lang, 'commodities')} variant="quiet">{d.home.heroSecondary}</Button>
        </div>
      </div>
      <QuotePanel lang={lang} class="hero__panel" />
    </div>
  </div>
</section>

<script>
  // Видео колосьев: только если пользователь не просил меньше движения и не экономит трафик.
  // Играет, пока экран виден; проявляется, когда пошли первые кадры.
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches && !conn?.saveData) {
    v.preload = 'auto';
    v.addEventListener('playing', () => v.setAttribute('data-playing', ''), { once: true });
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) v.play().catch(() => {});
      else v.pause();
    }).observe(v);
  }
</script>

<style>
  .hero {
    --H: max(40rem, 100svh);
    --R: max(var(--H), 56.25vw); /* высота кадра 16:9 при object-fit: cover */
    /* горизонт (гребень холма у солнца) — 40% высоты кадра */
    --horizon: calc(0.4 * var(--R) - (var(--R) - var(--H)) / 2);
    position: relative;
    background: var(--ink-950);
    color: var(--on-dark);
  }
  .hero__stage {
    position: relative;
    height: var(--H);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__media,
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__media :global(img),
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100% !important;
    object-fit: cover;
    object-position: 50% 50%;
  }
  .hero__media :global(img) {
    animation: hero-img 2600ms var(--ease-out) both;
  }
  /* видео проявляется поверх постера, когда пошли кадры — без вспышки и скачка */
  .hero__video {
    opacity: 0;
    transition: opacity 1200ms ease;
  }
  .hero__video[data-playing] {
    opacity: 1;
  }
  @keyframes hero-img {
    from {
      transform: scale(1.06);
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
  }
  .hero__shade {
    background:
      linear-gradient(180deg, rgb(14 13 10 / 0.55) 0%, rgb(14 13 10 / 0) 22%),
      linear-gradient(0deg, rgb(14 13 10 / 0.72) 0%, rgb(14 13 10 / 0.3) 24%, rgb(14 13 10 / 0) 48%),
      /* тень под заголовком и текстом слева — колосья в центре и справа остаются видны */
      radial-gradient(70% 75% at 0% 100%, rgb(14 13 10 / 0.72), rgb(14 13 10 / 0) 70%);
  }

  /* — Солнце: свет разгорается на горизонте вместе с линией — */
  .hero__sun {
    position: absolute;
    left: 50%; /* солнце в кадре — по центру */
    top: var(--horizon);
    z-index: -1;
    width: min(78rem, 150vw);
    aspect-ratio: 2.2 / 1;
    pointer-events: none;
    mix-blend-mode: screen;
    background:
      radial-gradient(closest-side, rgb(255 226 170 / 0.62), rgb(240 170 80 / 0.26) 34%, rgb(201 142 47 / 0.08) 62%, transparent 78%);
    transform: translate(-50%, -50%);
    animation: hero-sun 3200ms var(--ease-out) 150ms both;
    /* закат от прокрутки: --sun-k 0…1 пишет скрипт в Base */
    translate: 0 calc(var(--sun-k, 0) * 26%);
    /* в кадре своё солнце — наше свечение только подогревает его */
    opacity: calc(0.55 - var(--sun-k, 0) * 0.4);
  }
  @keyframes hero-sun {
    from {
      opacity: 0;
      transform: translate(-50%, -38%) scale(0.72);
    }
  }

  /* — Горизонт — */
  .hero__horizon {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--horizon);
    height: 0;
    pointer-events: none;
  }
  .hero__line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, rgb(242 236 224 / 0.12), rgb(242 236 224 / 0.35) 25%, rgb(241 215 162 / 0.85) 50%, rgb(242 236 224 / 0.35) 75%, rgb(242 236 224 / 0.12));
    transform-origin: 50% 50%;
    animation: hero-line 1500ms var(--ease-in-out) 250ms both;
  }
  @keyframes hero-line {
    from {
      transform: scaleX(0);
    }
  }
  .hero__coords {
    position: absolute;
    right: var(--gutter);
    top: 0.7rem;
    color: var(--paper-200);
    text-shadow: 0 1px 8px rgb(14 13 10 / 0.6);
    font-size: 0.6875rem;
    animation: hero-fade 900ms var(--ease-out) 1300ms both;
  }

  /* — Контент — */
  .hero__content {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: var(--s-10);
    padding-bottom: clamp(2rem, 1rem + 4vh, 4.5rem);
    align-items: end;
  }
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 0.9rem + 6.6vw, 6rem);
    font-weight: 360;
    line-height: 0.98;
    letter-spacing: -0.038em;
    color: var(--paper-50);
    text-wrap: initial;
  }
  .hero__ln {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .hero__ln > span {
    display: block;
    animation: hero-ln 1200ms var(--ease-out) both;
    animation-delay: calc(480ms + var(--i) * 90ms);
  }
  .hero__ln:last-child > span {
    font-style: italic;
    font-weight: 330;
    color: var(--gold-200);
  }
  @keyframes hero-ln {
    from {
      transform: translateY(104%);
    }
  }
  .hero__text {
    margin-top: var(--s-6);
    max-width: 31rem;
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--paper-200);
    animation: hero-fade 900ms var(--ease-out) 950ms both;
  }
  .hero__actions {
    margin-top: var(--s-4);
    color: var(--paper-100);
    animation: hero-fade 900ms var(--ease-out) 1050ms both;
  }
  .hero :global(.hero__panel) {
    width: 100%;
    max-width: 25rem;
    animation: hero-panel 1000ms var(--ease-out) 900ms both;
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @keyframes hero-panel {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  @media (min-width: 64rem) {
    .hero__content {
      grid-template-columns: 1fr auto;
      gap: var(--s-12);
    }
  }

  /* Телефон и планшет: форма уходит под кадр, наезжая на него — отдельный лист, а не уменьшенная копия */
  @media (max-width: 63.99rem) {
    .hero {
      --H: max(36rem, 86svh);
    }
    .hero :global(.hero__panel) {
      position: relative;
      max-width: 34rem;
      margin: calc(-1 * var(--s-12)) var(--gutter) 0;
      width: auto;
    }
    .hero__content {
      position: static;
      display: block;
    }
    .hero__copy {
      position: absolute;
      left: var(--gutter);
      right: var(--gutter);
      /* низ текста — над нижним краем кадра, а не над формой */
      bottom: calc(100% - var(--H) + var(--s-12) + 2.25rem);
    }
    .hero__stage {
      height: auto;
    }
    .hero__media,
    .hero__shade {
      height: var(--H);
      overflow: hidden;
    }
    /* текст на телефоне идёт почти во всю ширину — затемняем низ кадра целиком */
    .hero__shade {
      background:
        linear-gradient(180deg, rgb(14 13 10 / 0.55) 0%, rgb(14 13 10 / 0) 22%),
        linear-gradient(0deg, rgb(14 13 10 / 0.92) 0%, rgb(14 13 10 / 0.66) 34%, rgb(14 13 10 / 0) 66%);
    }
    .hero__content {
      padding-top: var(--H);
      padding-bottom: var(--s-12);
    }
  }
  /* на телефоне идёт квадратная версия видео (центр кадра) */
  @media (max-width: 37.5rem) {
    .hero {
      --R: max(var(--H), 100vw);
    }
  }
  @media (max-width: 47.99rem) {
    .hero__coords {
      display: none;
    }
    .hero__title {
      font-size: clamp(2.6rem, 1.2rem + 7.2vw, 3.6rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media :global(img),
    .hero__sun,
    .hero__line,
    .hero__coords,
    .hero__ln > span,
    .hero__text,
    .hero__actions,
    .hero :global(.hero__panel) {
      animation: none;
    }
  }
</style>
